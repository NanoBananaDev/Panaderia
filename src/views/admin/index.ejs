<%- include('../partials/header', { pageTitle: 'Administración' }) %>
<main class="admin-page section-space"><div class="container">
  <div class="admin-heading"><div><span class="eyebrow">PANEL DE CONTROL</span><h1>Administración</h1><p>Gestiona el catálogo de productos de la panadería.</p></div><% if (!readOnlyDemo) { %><a class="btn btn-gold rounded-pill px-4" href="/admin/productos/nuevo">＋ Agregar producto</a><% } %></div>
  <% if (readOnlyDemo) { %><div class="alert alert-info">Esta vista pública usa productos de muestra. Para agregar, editar y eliminar con persistencia, ejecuta el proyecto con Docker.</div><% } %>
  <% if (aviso) { %><div class="alert alert-<%= aviso.tipo %> alert-dismissible fade show" role="alert"><%= aviso.texto %><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button></div><% } %>
  <div class="admin-summary"><span><strong><%= productos.length %></strong> productos registrados en PostgreSQL</span><span class="database-status"><i></i> Base de datos conectada</span></div>
  <div class="table-responsive admin-table-wrap"><table class="table align-middle admin-table"><thead><tr><th>ID</th><th>Producto</th><th>Categoría</th><th>Precio</th><th>Stock</th><th class="text-end">Acciones</th></tr></thead><tbody>
  <% productos.forEach((p) => { %><tr><td class="muted-cell">#<%= p.id %></td><td><div class="table-product"><img src="<%= p.imagen %>" alt="" onerror="this.src='https://images.unsplash.com/photo-1509440159596-0249088772ff?auto=format&fit=crop&w=100&q=80'"><div><strong><%= p.nombre %></strong><small><%= p.descripcion %></small></div></div></td><td><span class="category-tag"><%= p.categoria %></span></td><td class="table-price"><%= formatPrice(p.precio) %></td><td><span class="stock-pill <%= Number(p.stock) === 0 ? 'stock-zero' : '' %>"><%= p.stock %></span></td><td><div class="d-flex justify-content-end gap-2"><% if (!readOnlyDemo) { %><a class="btn btn-sm btn-outline-dark rounded-pill px-3" href="/admin/productos/<%= p.id %>/editar">Editar</a><form action="/admin/productos/<%= p.id %>/eliminar" method="POST" onsubmit="return confirm('¿Eliminar <%= p.nombre %>? Esta acción no se puede deshacer.')"><button class="btn btn-sm btn-outline-danger rounded-pill px-3" type="submit">Eliminar</button></form><% } else { %><span class="text-muted small">Solo lectura</span><% } %></div></td></tr><% }) %>
  <% if (!productos.length) { %><tr><td colspan="6" class="text-center py-5">Todavía no hay productos. Agrega el primero para comenzar.</td></tr><% } %>
  </tbody></table></div>
  <div class="admin-tip"><span>✦</span> Los cambios se guardan directamente en PostgreSQL y permanecen al reiniciar Docker gracias al volumen <code>panaderia_data</code>.</div>
</div></main>
<%- include('../partials/footer') %>
