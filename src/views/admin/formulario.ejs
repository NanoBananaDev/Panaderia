<%- include('../partials/header', { pageTitle: titulo }) %>
<main class="admin-page section-space"><div class="container form-container">
  <a href="/admin" class="back-link">← Volver a administración</a>
  <div class="form-heading"><span class="eyebrow">CATÁLOGO DE PRODUCTOS</span><h1><%= titulo %></h1><p>Completa los datos para mantener actualizado el catálogo.</p></div>
  <% if (errores.length) { %><div class="alert alert-danger"><strong>Revisa estos campos:</strong><ul class="mb-0 mt-2"><% errores.forEach(e => { %><li><%= e %></li><% }) %></ul></div><% } %>
  <form class="product-form" action="<%= accion %>" method="POST">
    <div class="row g-3"><div class="col-md-7"><label for="nombre" class="form-label">Nombre del producto</label><input class="form-control" id="nombre" name="nombre" maxlength="120" required value="<%= producto.nombre || '' %>" placeholder="Ej. Pan de queso especial"></div>
      <div class="col-md-5"><label for="categoria" class="form-label">Categoría</label><select class="form-select" id="categoria" name="categoria" required><option value="">Selecciona una categoría</option><% categorias.forEach(c => { %><option value="<%= c %>" <%= producto.categoria === c ? 'selected' : '' %>><%= c %></option><% }) %></select></div>
      <div class="col-12"><label for="descripcion" class="form-label">Descripción</label><textarea class="form-control" id="descripcion" name="descripcion" rows="3" required placeholder="Cuenta qué hace especial este producto"><%= producto.descripcion || '' %></textarea></div>
      <div class="col-md-6"><label for="precio" class="form-label">Precio (Bs)</label><div class="input-group"><span class="input-group-text">Bs</span><input class="form-control" id="precio" name="precio" type="number" min="0" step="0.01" required value="<%= producto.precio || '' %>" placeholder="8.50"></div></div>
      <div class="col-md-6"><label for="stock" class="form-label">Stock disponible</label><input class="form-control" id="stock" name="stock" type="number" min="0" step="1" required value="<%= producto.stock ?? '' %>" placeholder="15"></div>
      <div class="col-12"><label for="imagen" class="form-label">URL de imagen</label><input class="form-control" id="imagen" name="imagen" type="url" required value="<%= producto.imagen || '' %>" placeholder="https://ejemplo.com/imagen.jpg"><div class="form-text">Usa una dirección web pública de imagen.</div></div>
    </div>
    <div class="form-actions"><a class="btn btn-outline-secondary rounded-pill px-4" href="/admin">Cancelar</a><button class="btn btn-gold rounded-pill px-4" type="submit"><%= producto.id ? 'Guardar cambios' : 'Guardar producto' %> →</button></div>
  </form>
</div></main>
<%- include('../partials/footer') %>
